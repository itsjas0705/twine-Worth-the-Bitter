/* ============================================================
   逐段揭示（以上 HAL 音效庫的程式碼完全沒有更動）
   ------------------------------------------------------------
   做的事：把 .txt 裡的 <p> 除了第一段以外先藏起來，
   讀者每點一次 ▾ 就多出現一段，全部讀完才顯示選項。
   同學在段落裡只要照常寫 <p>，不用做任何額外標記。
   ============================================================ */
(function () {
    "use strict";

    function setup(passage) {
        if (passage.dataset.reveal) { return; }   // 同一個段落只處理一次
        passage.dataset.reveal = "done";

        var box = passage.querySelector(".txt");
        if (!box) { return; }

        // 起始頁、結語頁這種「應該一次看完」的段落，
        // 在 <div class="txt"> 後面多加一個 no-reveal 就會跳過逐段揭示。
        if (box.classList.contains("no-reveal")) { return; }

        var paragraphs = box.querySelectorAll("p");
        var paths = box.querySelector(".paths");
        if (paragraphs.length < 2) { return; }    // 只有一段就不需要揭示

        // 第一段留著當開場，其餘先藏起來
        for (var i = 1; i < paragraphs.length; i++) {
            paragraphs[i].classList.add("is-hidden");
        }
        // 選項也一起藏：讀完整段敘述才做決定，選擇才有依據
        if (paths) { paths.classList.add("is-hidden"); }

        var next = 1;
        var cue = document.createElement("div");
        cue.className = "more";
        cue.textContent = "\u25be";
        cue.tabIndex = 0;                          // 讓鍵盤也能操作
        box.insertBefore(cue, (paths && paths.parentNode === box) ? paths : null);

        function advance() {
            paragraphs[next].classList.remove("is-hidden");
            paragraphs[next].classList.add("is-revealed");
            next += 1;

            if (next >= paragraphs.length) {       // 最後一段出現後
                if (paths) {
                    paths.classList.remove("is-hidden");
                    paths.classList.add("is-revealed");
                }
                cue.remove();                      // 收掉提示，畫面乾淨
            }
        }

        cue.addEventListener("click", advance);
        cue.addEventListener("keydown", function (event) {
            if (event.key === "Enter" || event.key === " ") {
                event.preventDefault();
                advance();
            }
        });
    }

    // Harlowe 每換一個段落就重新產生一個 <tw-passage>。
    // 用 MutationObserver 等它出現，比綁固定事件可靠，
    // 讀者按上一步回到舊段落時也能正確重跑。
    new MutationObserver(function (records) {
        records.forEach(function (record) {
            Array.prototype.forEach.call(record.addedNodes, function (node) {
                if (node.nodeType === 1 && node.tagName === "TW-PASSAGE") {
                    setup(node);
                }
            });
        });
    }).observe(document.body, { childList: true, subtree: true });

    // 第一個段落有可能在這段程式跑起來之前就畫好了，補跑一次
    document.addEventListener("DOMContentLoaded", function () {
        Array.prototype.forEach.call(document.querySelectorAll("tw-passage"), setup);
    });
}());

