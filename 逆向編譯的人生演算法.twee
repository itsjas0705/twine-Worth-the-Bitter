ttom:0;background:#333;color:#eee;transition:left .3s;text-align:center}div#audio-controls.closed{left:-10.5em}div#audio-controls tw-link#audio-panel-toggle{display:inline-block;width:1.5em;position:absolute;height:1.5em;top:0;right:0;-webkit-user-select:none;-moz-user-select:none;-ms-user-select:none;user-select:none;text-decoration:none;background-image:url(data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAACQAAAAkCAQAAABLCVATAAAAYklEQVR4Ae3MsQFAMAAEQMDEagCgN4EuVTrbPcACeUBugDNeSdMQomI0PmYdTEYD9DA5jcVoBKuxGY1kNQ6jGRSaGaIj8gw1aI/KYVUSNqsSzMpiVT2zMjlVN0fqVW5o2luMGHqkQmD9cPYAAAAASUVORK5CYII=);background-size:contain}div#audio-controls.closed tw-link#audio-panel-toggle{background-image:url(data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAACQAAAAkCAQAAABLCVATAAAAZElEQVR4Ae3TpwGAMBQAUfrEeHB0cDhcXBSO7ehlgBw9N8BL/YZO95r6uA/UEbOv+ylfHRJ9z1BWLynKJqmWohyS6ijKOygKCpmjZYqXTTA2xUiCsShGAMw8/Q3ArFgFMHek0w3WCaR74eO2YQAAAABJRU5ErkJggg==)}@media screen and (max-width:800px){div#audio-controls.closed{left:-12em}div#audio-controls.closed tw-link#audio-panel-toggle{right:-1.5em}}div#story-menu{margin:1em 0}tw-link.story-menu{width:100%;display:block;font-weight:400;background:#ccc;font-size:.9em;padding:.1em 0;color:#111;border:1px solid #333}tw-link.story-menu.hide{display:none}tw-link.story-menu:hover{opacity:.8}tw-link.story-menu:active{opacity:.6}input[type=range].hal{-webkit-appearance:none;width:100%;margin:2.25px 0}input[type=range].hal:focus{outline:0}input[type=range].hal::-webkit-slider-runnable-track{width:100%;height:15.5px;cursor:pointer;box-shadow:.4px .4px 1px #000,0 0 .4px #0d0d0d;background:#111;border-radius:0;border:0 solid #010101}input[type=range].hal::-webkit-slider-thumb{box-shadow:0 0 2.2px rgba(17,17,17,.1),0 0 0 rgba(30,30,30,.1);border:0 solid #fff;height:20px;width:11px;border-radius:0;background:rgba(255,255,255,.93);cursor:pointer;-webkit-appearance:none;margin-top:-2.25px}input[type=range].hal:focus::-webkit-slider-runnable-track{background:#444}input[type=range].hal::-moz-range-track{width:100%;height:15.5px;cursor:pointer;box-shadow:.4px .4px 1px #000,0 0 .4px #0d0d0d;background:#111;border-radius:0;border:0 solid #010101}input[type=range].hal::-moz-range-thumb{box-shadow:0 0 2.2px rgba(17,17,17,.1),0 0 0 rgba(30,30,30,.1);border:0 solid #fff;height:20px;width:11px;border-radius:0;background:rgba(255,255,255,.93);cursor:pointer}input[type=range].hal::-ms-track{width:100%;height:15.5px;cursor:pointer;background:0 0;border-color:transparent;color:transparent}input[type=range].hal::-ms-fill-lower{background:#000;border:0 solid #010101;border-radius:0;box-shadow:.4px .4px 1px #000,0 0 .4px #0d0d0d}input[type=range].hal::-ms-fill-upper{background:#111;border:0 solid #010101;border-radius:0;box-shadow:.4px .4px 1px #000,0 0 .4px #0d0d0d}input[type=range].hal::-ms-thumb{box-shadow:0 0 2.2px rgba(17,17,17,.1),0 0 0 rgba(30,30,30,.1);border:0 solid #fff;height:20px;width:11px;border-radius:0;background:rgba(255,255,255,.93);cursor:pointer;height:15.5px}input[type=range].hal:focus::-ms-fill-lower{background:#111}input[type=range].hal:focus::-ms-fill-upper{background:#444}
/** End of HAL code */


/* ============================================================
   以下是本作品的版面樣式（HAL 音效庫以上的部分請勿更動）
   1. 全站基底      2. 各幕背景      3. 兩欄骨架
   4. 左欄影像      5. 右欄敘述      6. 選項與連結
   7. 通用小工具    8. 逐段揭示      9. 滿版畫面 .cinema
   10. 特殊段落     11. 結尾頁       12. 圖片寬度小工具
   13. 返回上一頁    14. 關閉動態
   ============================================================ */


/* ------------------------------------------------------------
   1. 全站基底
   ------------------------------------------------------------
   html/body 也要塗底色。背景圖是畫在 tw-story 上的，
   而 tw-story 只有「內容那麼高」；一旦內容底部的空白
   或捲動回彈超出它的範圍，露出的就是瀏覽器預設的白色畫布
   ——這就是白底的來源。塗上底色 + 下面的 min-height，
   兩層保險一起把它堵死。
------------------------------------------------------------ */
html,
body {
    background-color: #0d0b0a;
    margin: 0;
}

tw-story {
    min-height: 100vh;          /* 內容再短，背景也一定鋪滿整個視窗高度 */
    box-sizing: border-box;     /* 讓 padding 算在 100vh 之內，不會被擠出捲軸 */
    padding: 3rem 3rem 3rem 5rem;
                                /* 左邊留 5rem：HAL 的音量面板收合後，
                                   開關把手還是會壓在畫面最左側，
                                   留白才不會蓋到左欄的圖片 */
    font-family: "LXGW WenKai Mono TC", "Xiaolai Mono SC", serif;
                                /* 字體在這裡設一次就好。
                                   (enchant: ?page, (font:)) 只指定名稱、不負責載入，
                                   而且要每個段落重寫一次，可以不用了 */
    font-size: 1.05rem;
    line-height: 1.9;           /* 中文長段落的舒適行高 */
    color: #f2ede6;
}


/* ------------------------------------------------------------
   2. 各幕背景
   ------------------------------------------------------------
   靠段落 tag 切換。Harlowe 會把當前段落的 tag 寫進
   <tw-story> 的 tags 屬性，所以選擇器要用 [tags~="..."]，
   寫成 .chapter1 這種 class 是不會生效的。
   要新增一幕：把 tag 加進下面的清單，再補一組 background-image。

   註：結尾頁目前沿用 chapter4 的背景。若要給它專屬的圖，
   把 tw-story[tags~="ending"] 加進下面的清單，
   再補一組 background-image 即可。
------------------------------------------------------------ */
tw-story[tags~="cover"],
tw-story[tags~="chapter0"],
tw-story[tags~="chapter1"],
tw-story[tags~="chapter2"],
tw-story[tags~="chapter3"],
tw-story[tags~="chapter4"] {
    background-size: cover;         /* 滿版：等比放大到蓋滿畫面 */
    background-position: center;    /* 被裁切時以中心為準 */
    background-repeat: no-repeat;   /* 只出現一張，不平鋪 */
    background-attachment: fixed;   /* 固定：捲動文字時背景不動 */
}

tw-story[tags~="cover"] {
    background-image: url("images/cover.jpeg");
}

tw-story[tags~="chapter0"] {
    background-image: url("images/Worth-the-Bitter_background0.jpeg");
}

tw-story[tags~="chapter1"] {
    background-image: url("images/Worth-the-Bitter_background1.jpeg");
}

tw-story[tags~="chapter2"] {
    background-image: url("images/Worth-the-Bitter_background2.jpeg");
}

tw-story[tags~="chapter3"] {
    background-image: url("images/Worth-the-Bitter_background3.jpeg");
}

tw-story[tags~="chapter4"] {
    background-image: url("images/Worth-the-Bitter_background4.jpeg");
}


/* ------------------------------------------------------------
   3. 兩欄骨架
   ------------------------------------------------------------
   用一個 <div class="scene"> 當容器，而不是直接對 tw-passage 下 grid：
   tw-passage 裡面還有 Harlowe 自己的側邊箭頭，
   包在自己的 div 裡就不會互相干擾。
------------------------------------------------------------ */
.scene {
    display: grid;
    grid-template-columns: 40% 1fr;   /* 左 40% 放影像，右邊吃掉剩下的 */
    gap: 2.5rem;
    align-items: start;               /* 兩欄各自貼齊頂端；也是 .pic 能 sticky 的前提 */
    max-width: 1200px;
    margin: 0 auto;                   /* 大螢幕置中，行長不會拉得太寬 */
    padding: 2rem;
    border-radius: 16px;
    background: rgba(0, 0, 0, .72);   /* 灰底在這一層，圖片和文字共用同一塊面板。
                                         .72 是實測值：底圖亮的時候 .55 撐不住楷體的
                                         細筆畫，文字會顯得糊。
                                         包在一起也讓「這一幕」在視覺上是一個整體 */
}

.scene > br,
.scene > tw-consecutive-br {
    display: none;                    /* Harlowe 會把 div 與 div 之間的換行變成元素：
                                         單一換行是 <br>，連續兩個以上是 <tw-consecutive-br>。
                                         它們在 grid 裡會各佔一個空格子、把右欄擠到下一列，
                                         兩種都要擋。只擋直接子層，段落內的換行不受影響 */
}

/* 明確指定每一塊在第幾列、第幾欄。
   不靠 grid 的自動排列，就算日後又冒出什麼多餘元素，
   也絕對推不動這三塊的位置。 */
.title {
    grid-row: 1;
    grid-column: 1 / -1;              /* 幕名橫跨兩欄（1 / -1 = 從第一條格線跨到最後一條） */
    text-align: center;
    margin-bottom: 1rem;
}


/* ------------------------------------------------------------
   4. 左欄：影像
------------------------------------------------------------ */
.pic {
    grid-row: 2;
    grid-column: 1;                   /* 第二列左欄 —— 和 .txt 同一列，兩者才會齊頭並排 */
    position: sticky;                 /* 右邊文字很長時，圖片跟著捲動停在視窗裡 */
    top: 2rem;                        /* 停在距離視窗頂端 2rem 的位置 */
}

.pic img,
.pic video {
    display: block;                   /* 去掉 inline 元素底部那條多餘空隙 */
    width: 100%;
    height: auto;                     /* 等比縮放，不變形也不裁切 */
    margin-bottom: 1rem;              /* 同欄放多個影像時的間距 */
    border-radius: 8px;
}


/* ------------------------------------------------------------
   5. 右欄：敘述
------------------------------------------------------------ */
.txt {
    grid-row: 2;
    grid-column: 2;                   /* 第二列右欄 —— 和 .pic 同一列 */
    text-shadow: 0 1px 3px rgba(0, 0, 0, .85);
                                      /* 楷體筆畫細，壓在圖上容易糊。
                                         一層淺陰影等於幫每個字描邊，
                                         比把字調更亮有效，也不會刺眼 */
    align-self: center;               /* 覆蓋 .scene 的 align-items: start。
                                         這一列的高度由較高的那一欄決定，
                                         文字短的時候就在這個高度裡上下置中，
                                         文字比圖片長時這行自動失效，不必再改 */
}

.txt > br,
.txt > tw-consecutive-br {
    display: none;                    /* 敘述一律用 <p> 分段，不靠換行。
                                         擋掉 Harlowe 自動產生的換行元素，
                                         才不會 <p> 的段距再加上一層空行變成雙倍。
                                         好處：在編輯器裡怎麼排版都不影響輸出 */
}

.txt p {
    margin: 0 0 1.25em;               /* 段距用 margin 控制，比 <br><br> 精準 */
}

.txt p:last-child {
    margin-bottom: 0;                 /* 最後一段不要多出一截空白 */
}

.txt p:first-of-type {
    font-size: 1.08em;
    color: #ffffff;                   /* 開場第一段略大略亮，像鏡頭先給一個定場 */
}


/* ------------------------------------------------------------
   6. 選項與連結
   ------------------------------------------------------------
   限定在 tw-passage 之內，才不會動到 HAL 音量面板上的
   tw-link（靜音鈕、選單鈕都在 tw-passage 外面）。
------------------------------------------------------------ */
tw-passage tw-link,
tw-passage .enchantment-link {
    color: #ffb84d;                   /* 和內文明顯區隔，一眼看出哪裡可以點 */
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 184, 77, .6);
}

tw-passage tw-link:hover,
tw-passage .enchantment-link:hover {
    color: #ffffff;
    border-bottom-color: #ffffff;     /* 滑鼠移上去有回饋，降低操作猶豫 */
}

.paths {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, .15);
                                      /* 一條分隔線，把「敘述」和「該做選擇了」分開 */
}

.paths tw-link {
    display: block;                   /* 選項各自一行，變成一份選單而不是句中連結 */
    position: relative;               /* 讓下面的箭頭可以定位在左側 */
    margin-top: .7em;
    padding: .7em 1em .7em 2.2em;     /* 左側留白給箭頭 */
    border: 1px solid rgba(255, 184, 77, .7);
    border-radius: 8px;
    background: rgba(38, 24, 6, .8);
    font-weight: 500;
                                      /* 做成按鈕：選項是「要做決定」，
                                         給它一塊實體範圍，比一行底線更有重量。
                                         底色用接近不透明的深棕而不是淡淡的透明橘，
                                         背景圖再花也看得出這是一顆可以按的東西 */
    transition: background .2s ease, border-color .2s ease, transform .2s ease;
                                      /* 有 transition 才是「滑過去」而不是「跳一下」 */
}

.paths tw-link::before {
    content: "▸";
    position: absolute;
    left: 1em;
    transition: left .2s ease;
}

.paths tw-link:hover {
    background: rgb(88, 56, 12);      /* 三個值要用 rgb() 而不是 rgba()。
                                         新版瀏覽器兩種都吃，但 rgba() 少寫透明度
                                         是新語法，教材裡寫標準寫法比較穩 */
    border-color: #ffb84d;            /* 邊框轉為實色，和未選中的狀態拉開差距 */
    transform: translateX(4px);       /* 只移 4px：內斂，但足夠讓人知道「這個被選中了」 */
}

.paths tw-link:hover::before {
    left: 1.3em;                      /* 箭頭比卡片再往前一點，做出「往前走」的暗示 */
}


/* ------------------------------------------------------------
   7. 通用小工具
------------------------------------------------------------ */
img {
    max-width: 100%;                  /* 全站保險：任何圖都不會撐破欄位 */
    height: auto;
}

.speaker {
    float: left;                      /* 對話頭像，讓文字繞著它排 */
    width: 110px;
    margin: 0 1em .5em 0;
    text-align: center;
    font-size: .9em;
    color: #f2ede6;                   /* 深色底上要用淺色字 */
    user-select: none;                /* 頭像和名字不該被反白選取 */
}

.speaker img {
    width: 100%;
    border-radius: 50%;               /* 用 50% 而不是固定 px，任何尺寸都保證是正圓 */
}


/* ------------------------------------------------------------
   8. 逐段揭示
   ------------------------------------------------------------
   由 Story JavaScript 那段程式負責控制「現在該顯示第幾段」，
   CSS 只負責兩件事：藏起來的樣子，和浮現時的樣子。
   起始頁、結語頁不想逐段點開時，在 <div class="txt"> 後面
   多加一個 no-reveal 即可。
------------------------------------------------------------ */
.is-hidden {
    display: none;                    /* 還沒輪到的段落，以及全部讀完前的選項 */
}

.is-revealed {
    animation: rise .4s ease-out both;
                                      /* 只有「剛被點出來」的那一段會跑動畫。
                                         第一段和換頁時的內容不套，
                                         所以進場是安靜的、沒有整片淡入 */
}

@keyframes rise {
    from {
        opacity: 0;
        transform: translateY(12px);  /* 從下方 12px 浮上來，距離短才不會像在跳 */
    }
}

.more {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.4em;
    height: 2.4em;                    /* 做成圓鈕，而不是一個光禿禿的箭頭。
                                         有邊界才看得出「可以按」，也才點得準 ——
                                         單一個字的點擊範圍太小 */
    margin: 1.6em auto 0;             /* 定寬 + auto 左右外距 = 置中 */
    border: 1px solid rgba(255, 184, 77, .75);
    border-radius: 50%;
    background: rgba(38, 24, 6, .85); /* 和選項按鈕同一套底色，
                                         整個作品「可以點的東西」長得一致 */
    color: #ffb84d;
    font-size: 1.6em;                 /* 這是讀者最常按的東西，箭頭本身也放大。
                                         小箭頭在滿版的圖旁邊很容易被忽略 */
    line-height: 1;                   /* 字放大後行高要收回來，
                                         否則圓鈕會被撐成橢圓 */
    cursor: pointer;                  /* 游標變手指，讀者才知道這裡可以點 */
    user-select: none;
    transition: background .2s ease, border-color .2s ease, transform .2s ease;
    animation: breathe 1.8s ease-in-out infinite;
                                      /* 緩慢呼吸，提示「還有下一段」。
                                         這是畫面上唯一持續的動態，
                                         剛好落在讀者讀完一段後視線會到的位置 */
}

.more:hover {
    background: rgb(88, 56, 12);
    border-color: #ffb84d;
    color: #ffffff;
    transform: translateY(3px);       /* 往下沉一點，暗示「往下讀」 */
}

@keyframes breathe {
    50% { opacity: .68; }             /* 只降到 68%。原本的 .4 會讓按鈕在半個週期裡
                                         淡到快看不見，和「要更顯眼」正好相反 */
}


/* ------------------------------------------------------------
   9. 滿版畫面（.cinema）
   ------------------------------------------------------------
   和 .scene 二選一的另一種版型，用在「一整幕只有一張畫面」的時刻。
   段落裡用 .cinema 就不要再包 .scene。
   文字的出現時機由段落裡的 (after:) 巨集決定，
   CSS 只負責版面和浮現的樣子。
------------------------------------------------------------ */
.cinema {
    position: fixed;
    inset: 0;                         /* 貼齊視窗四邊。用 fixed 才能跳脫 tw-story 的留白，
                                         真正做到滿版 */
    z-index: 1;                       /* 蓋住底下的版面，但遠低於 HAL 音量面板（10000），
                                         讀者隨時還是能調音量 */
    display: flex;
    align-items: flex-end;            /* 文字沉在畫面下緣，像電影字幕的位置 */
    justify-content: center;
    overflow-y: auto;                 /* 文字萬一比視窗長，還能捲 */
    background: #0d0b0a;              /* 圖還沒載入時不會閃白 */
}

.cinema > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;                /* 等比填滿整個視窗。
                                         滿版的重點是不留黑邊，所以這裡接受裁切 */
    margin: 0;
    border-radius: 0;                 /* 蓋掉 .pic img 的圓角 */
}

.cinema::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;             /* 只是一層顏色，不擋滑鼠 */
    background: linear-gradient(
        to top,
        rgba(0, 0, 0, .88) 0%,
        rgba(0, 0, 0, .35) 35%,
        rgba(0, 0, 0, 0) 65%
    );                                /* 由下往上的漸層遮罩。
                                         比整塊灰底好：畫面上半部完全不被遮住，
                                         下半部又暗到足以撐住白字 */
}

.cinema .lines {
    position: relative;
    z-index: 1;                       /* 疊在圖片和遮罩之上 */
    width: min(720px, 80%);
    padding: 25vh 0 12vh;             /* 上方留白讓文字不會太靠中間；
                                         下方留白讓它不貼著視窗底邊 */
    text-align: center;               /* 短句居中最像定場字幕；
                                         這一幕如果話很多，改成 left 比較好讀 */
    text-shadow: 0 2px 14px rgba(0, 0, 0, .9);
                                      /* 遮罩之外再加一層保險，
                                         避免文字剛好壓在圖上的亮處 */
}

.cinema .lines > br,
.cinema .lines > tw-consecutive-br {
    display: none;                    /* 同樣的理由：分段交給 <p>，不靠換行 */
}

.cinema .lines p {
    margin: 0 0 1.6em;                /* 比一般敘述再鬆一點，一句一句慢慢讀 */
    font-size: 1.15em;
}

.cinema .lines p,
.cinema .lines .paths {
    animation: fade-up 1.8s ease-out both;
                                      /* (after:) 讓元素在指定秒數後才進 DOM，
                                         一進來就跑這個動畫。
                                         1.8 秒是刻意放慢的：這一幕的重點是停頓 */
}

@keyframes fade-up {
    from {
        opacity: 0;
        transform: translateY(18px);
    }
}


/* ------------------------------------------------------------
   10. 兩種特殊段落
   ------------------------------------------------------------
   用法：<p class="quote"> 或 <p class="note">
   .quote —— 想讓讀者記住的一句話
   .note  —— 補充說明、名詞解釋、史料出處

   選擇器寫成 .txt p.quote 而不是單純 .quote，是為了贏過
   第 5 段的 .txt p:first-of-type（開場第一段的特別樣式）。
   否則把 quote 放在段落開頭時會被蓋掉。
------------------------------------------------------------ */
.txt p.quote,
.cinema p.quote {
    margin: 2em 0;
    padding-left: 1.1em;
    border-left: 3px solid rgba(255, 255, 255, .45);
                                      /* 左側一條線是最省的做法：
                                         不用引號圖案、不用背景色，
                                         單靠一條線就把這幾行從敘述裡拉出來 */
    font-size: 1.2em;
    line-height: 1.75;                /* 字大了行高要跟著調，否則會擠 */
    color: #ffffff;                   /* 刻意不用橘色：
                                         這個作品裡橘色專門代表「可以點」，
                                         拿來裝飾不能點的文字會讓讀者誤會 */
}

.txt p.note,
.cinema p.note {
    margin: 1.5em 0;
    padding-left: 1em;
    border-left: 2px dashed rgba(242, 237, 230, .28);
                                      /* 虛線和 quote 的實線區分：
                                         實線是「重點」，虛線是「補充」 */
    font-size: .9em;
    line-height: 1.75;
    color: rgba(242, 237, 230, .8);   /* 只降一點點。註解要退到後面，
                                         但仍然要讀得清楚 —— 淡到看不見的註解
                                         等於沒寫 */
}

.txt p.note::before,
.cinema p.note::before {
    content: "※ ";                    /* 一個記號就足以說明「這不是故事，是補充」 */
}


/* ------------------------------------------------------------
   11. 結尾頁（.ending）
   ------------------------------------------------------------
   和 .scene 一樣是「一整塊容器」，但做成毛玻璃：
   底色很淡、把背後的圖糊掉，整片輕輕浮動。
   和 .scene / .cinema 三選一，不要混用。
------------------------------------------------------------ */
.ending {
    max-width: 1000px;
    margin: 8vh auto;
    padding: 3.5rem 3rem;
    border-radius: 20px;
    text-align: center;

    background: rgba(20, 16, 12, .42);
    backdrop-filter: blur(16px) saturate(120%);
    -webkit-backdrop-filter: blur(16px) saturate(120%);
                                      /* 毛玻璃的本體：底色只有 42%，
                                         真正讓文字浮出來的是 blur —— 它把背後的
                                         紋理糊成色塊，文字就不會被線條吃掉。
                                         這也是為什麼底色可以壓得比 .scene 淡很多，
                                         背景圖的氛圍還看得見 */

    border: 1px solid rgba(255, 255, 255, .18);
                                      /* 邊緣一圈微亮的線。毛玻璃之所以像玻璃，
                                         靠的就是這道邊 —— 少了它只會像一塊霧 */
    box-shadow: 0 24px 60px rgba(0, 0, 0, .45);
                                      /* 投影讓它離開背景，浮在畫面上而不是貼著 */

    animation: float 7s ease-in-out infinite;
}

@keyframes float {
    50% { transform: translateY(-10px); }
                                      /* 整片一起浮 10px，週期 7 秒。
                                         慢到幾乎察覺不到在動，只覺得畫面是活的。
                                         這組 keyframes 一定要留著 ——
                                         少了它，上面那行 animation 會被靜靜略過，
                                         不會報錯，畫面就只是靜止不動 */
}

.ending > br,
.ending > tw-consecutive-br {
    display: none;                    /* 同樣的理由：分段交給 <p> */
}

.ending p {
    margin: .5em 0;                   /* 段距收緊 */
    font-size: 1.12em;
    line-height: 1.8;                 /* 中文行高不要低於 1.5，否則上下兩行會黏在一起。
                                         想讓段落之間更緊湊，調上面的 margin，不要動這裡 */
    color: #ffffff;
    text-shadow: 0 1px 4px rgba(0, 0, 0, .6);
}

.ending .paths {
    max-width: 380px;
    margin: 3rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, .18);
                                      /* 一條分隔線：上面是故事，下面是離場的出口 */
}


/* 開發團隊 —— 在毛玻璃內部，所以不用再鋪一層底 */
.credits {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, .18);
    font-size: 1em;
    color: rgba(242, 237, 230, .9);
}

.credits img {
    display: block;
    width: 92px;
    height: 92px;
    margin: 0 auto 1rem;
    border-radius: 50%;
    object-fit: cover;                /* 不管上傳的是方是長，都裁成正圓 */
    border: 2px solid rgba(255, 255, 255, .4);
}

.credits p {
    margin: .25em 0;                  /* 署名是資訊不是敘述，行距收緊 */
    font-size: 1em;
    line-height: 1.7;
    text-shadow: none;
}

.ending .lines > br,
.ending .lines > tw-consecutive-br {
    display: none;                    /* 每個 (after:) 各佔一行，
                                         行與行之間的換行會變成多餘的空白，擋掉 */
}


/* 多人團隊：一人一格，排成一列
   用法：
   <div class="team">
   <div class="member"><img src="..."><p>姓名</p><p class="role">分工</p></div>
   ...
   </div>                                                        */
.team {
    display: flex;
    flex-wrap: wrap;                  /* 放不下就自動換行 */
    justify-content: center;          /* 用 flex 而不是 grid：人數不整齊時
                                         （例如 4+2），最後一列也會置中，
                                         不會孤零零靠在左邊 */
    gap: 1.5rem 2rem;                 /* 上下間距、左右間距 */
    margin-top: 1.5rem;
}

.team > br,
.team > tw-consecutive-br,
.member > br,
.member > tw-consecutive-br {
    display: none;                    /* 同樣的理由：Harlowe 的換行會變成多餘的格子 */
}

.member {
    width: 110px;                     /* 每一格固定寬度，名字才會對成整齊的欄 */
    text-align: center;
}

.member img {
    width: 76px;
    height: 76px;                     /* 比單人版的 92px 小：
                                         六個人排一列時，頭像太大會擠 */
    margin: 0 auto .6rem;
}

.member p {
    margin: 0;
    line-height: 1.5;
}

.member .role {
    font-size: .8em;
    color: rgba(242, 237, 230, .65); /* 分工是次要資訊，退一階 */
}


/* ------------------------------------------------------------
   12. 圖片寬度小工具
   ------------------------------------------------------------
   用法：<img class="w60" src="...">
   百分比是相對於「它所在的容器」，不是整個視窗 ——
   同一個 w60 放在 .ending 和放在 .pic 裡，實際寬度不一樣。
   放在最後一段，才蓋得過前面 .pic img 的 width: 100%。
------------------------------------------------------------ */
img.w30 { width: 30%; }
img.w40 { width: 40%; }
img.w50 { width: 50%; }
img.w60 { width: 60%; }
img.w75 { width: 75%; }

img.w30,
img.w40,
img.w50,
img.w60,
img.w75 {
    display: block;
    height: auto;                     /* 只給寬度、高度自動，圖才不會變形 */
    margin: 1.5em auto;               /* 縮小之後要置中，否則會孤零零靠在左邊 */
    border-radius: 10px;
}


/* ------------------------------------------------------------
   13. 返回上一頁
   ------------------------------------------------------------
   由一個 tag 為 header 的段落自動加到每一頁頂端，不必逐段複製。
   header 段落內容（寫成一行）：
   (unless: (passage:)'s tags contains "cover")[<div class="back">(link-undo: "← 返回上一頁")</div>]

   不用 position: fixed 的原因：固定定位的元素「不佔空間」，
   內容照樣排在它底下，面板或圖片經過那個角落就一定會疊到。
   改成正常排版，按鈕自己佔一列、放在面板正上方，永遠不會重疊。
------------------------------------------------------------ */
.back {
    max-width: 1200px;                /* 和 .scene 同寬，再用 auto 置中 —— */
    margin: 0 auto 1rem;              /* 按鈕的左緣就會剛好對齊面板的左緣 */
    position: relative;
    z-index: 2;                       /* 比 .cinema 的 1 高，
                                         滿版畫面那幾幕也蓋不住它 */
}

.back tw-link {
    display: inline-block;
    padding: .45em 1.1em;
    border: 1px solid rgba(255, 255, 255, .25);
    border-radius: 999px;
    background: rgba(0, 0, 0, .55);
    backdrop-filter: blur(6px);       /* 底圖再花也讀得到 */
    -webkit-backdrop-filter: blur(6px);
    color: rgba(255, 255, 255, .75);
    font-size: .85em;
    font-weight: 400;
                                      /* 刻意不用橘色。橘色在這個作品裡代表
                                         「往前走的選擇」，返回是輔助動作，
                                         用中性的白灰色才不會跟劇情選項搶注意力 */
    transition: background .2s ease, color .2s ease, border-color .2s ease;
}

.back tw-link:hover {
    color: #ffffff;
    background: rgba(0, 0, 0, .78);
    border-color: rgba(255, 255, 255, .6);
}

/* 滿版畫面（.cinema）那幾頁的例外
   整個視窗都是圖，按鈕放哪都會壓到，只能把干擾降到最低：
   1. 沒有面板可以對齊，改成貼在視窗最角落 —— 通常是構圖裡最不重要的位置
   2. 平常半透明，滑鼠移過去才完全清楚：需要時找得到，不需要時不搶畫面
   :has(.cinema) 的意思是「裡面有 .cinema 的那一頁」，
   段落不用加任何標記，瀏覽器會自己判斷。 */
tw-passage:has(.cinema) .back {
    position: fixed;
    top: 1rem;
    left: 3.6rem;                     /* 避開 HAL 音量面板的開關把手 */
    margin: 0;
    opacity: .45;
    transition: opacity .3s ease;
}

tw-passage:has(.cinema) .back:hover {
    opacity: 1;
}


/* ------------------------------------------------------------
   14. 關閉動態
   ------------------------------------------------------------
   有些人看動態畫面會頭暈。作業系統設定「減少動態效果」時，
   整份作品的動畫一次全部停用。集中寫在最後，
   日後新增動畫只要把選擇器加進這一組就好。
------------------------------------------------------------ */
@media (prefers-reduced-motion: reduce) {
    .is-revealed,
    .more,
    .cinema .lines p,
    .cinema .lines .paths,
    .ending {
        animation: none;
    }
}